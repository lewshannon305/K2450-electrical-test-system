# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# PyInstaller uses compiled Python extension modules inside runtime.
!runtime/*.pyd
!runtime/**/*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and packaging output
.venv/
.build-venv/
venv/
env/
.build/
build/
dist/
*.egg-info/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local logs and generated measurement/plot output
*.log
results/
plots/
configs/plotting_default.json
